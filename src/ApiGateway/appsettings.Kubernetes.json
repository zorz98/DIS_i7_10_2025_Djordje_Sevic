{
  "Consul": {
    "Enabled": false
  },
  "ReverseProxy": {
    "Routes": {
      "transactions-route": {
        "ClusterId": "transaction-service-cluster",
        "Match": { "Path": "/transactions/{**catch-all}" }
      },
      "esg-route": {
        "ClusterId": "esg-service-cluster",
        "Match": { "Path": "/esg/{**catch-all}" }
      },
      "categories-route": {
        "ClusterId": "reference-data-service-cluster",
        "Match": { "Path": "/categories/{**catch-all}" }
      },
      "emission-factors-route": {
        "ClusterId": "reference-data-service-cluster",
        "Match": { "Path": "/emission-factors/{**catch-all}" }
      },
      "reports-route": {
        "ClusterId": "report-service-cluster",
        "Match": { "Path": "/reports/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-service-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "transaction-service-cluster": {
        "Destinations": { "d1": { "Address": "http://transaction-service:8080" } }
      },
      "esg-service-cluster": {
        "Destinations": { "d1": { "Address": "http://esg-service:8080" } }
      },
      "reference-data-service-cluster": {
        "Destinations": { "d1": { "Address": "http://reference-data-service:8080" } }
      },
      "report-service-cluster": {
        "Destinations": { "d1": { "Address": "http://report-service:8080" } }
      },
      "notification-service-cluster": {
        "Destinations": { "d1": { "Address": "http://notification-service:8080" } }
      }
    }
  }
}
